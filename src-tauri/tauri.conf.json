{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "network-chat",
  "version": "0.1.7",
  "identifier": "com.nandan.networkchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Network Chat",
        "width": 1000,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Network Chat needs access to your microphone for voice calls.",
        "NSCameraUsageDescription": "Network Chat needs access to your camera for video calls."
      }
    }
  }
}
